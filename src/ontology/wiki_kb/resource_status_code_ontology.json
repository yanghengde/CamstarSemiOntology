          "type": "Integer",
          "description": "用于MM/MDM集成。"
        },
        {
          "name": "omlStatus",
          "type": "String",
          "description": "OML状态。"
        },
        {
          "name": "statusId",
          "type": "Integer",
          "description": "通用整数。"
        },
        {
          "name": "filterTags",
          "type": "String",
          "description": "分类筛选标签"
        }
      ]
