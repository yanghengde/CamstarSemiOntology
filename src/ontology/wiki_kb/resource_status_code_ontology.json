        },
        {
          "name": "notes",
          "type": "String",
          "description": "备注信息"
        },
        {
          "name": "resourceState",
          "type": "Integer",
          "description": "资源状态定义：1.非计划，2.非计划停机，3.计划停机，4.工程，5.生产，6.待机。"
        },
        {
          "name": "resourceStatusReasons",
          "type": "Navigation",
          "description": "关联的资源状态原因组。"
