          "description": "关联的建模访问权限（A_SetupAccess）。"
        },
        {
          "name": "isAvailable",
          "type": "Boolean",
          "description": "物理字段 IsAvailable"
        },
        {
          "name": "nextTxnType",
          "type": "Integer",
          "description": "资源处于此状态时默认“下一步”（生产）事务的ID。"
        },
        {
          "name": "changeHistory",
          "type": "Navigation",
          "description": "变更历史记录"
        },
        {
          "name": "description",
          "type": "String",
          "description": "描述说明"
        },
        {
          "name": "iconId",
          "type": "Integer",
          "description": "关联的图标 ID"
        },
        {
          "name": "isFrozen",
          "type": "Boolean",
          "description": "是否已冻结（只读）"
        },
        {
          "name": "name",
          "type": "String",
          "description": "资源状态代码的唯一名称（必填）",
