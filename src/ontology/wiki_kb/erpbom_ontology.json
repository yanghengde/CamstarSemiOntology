    {
      "className": "ERPBOM",
      "chineseName": "ERP物料清单",
      "description": "ERP Bill of Materials — 从 ERP 系统下载到 InSite 的 BOM，由外部系统（如 SAP）控制和管理。与原生 BOM 不同，ERPBOM 包含 ERP 路由步骤引用，其物料行使用独立的 BOMMaterialListItem 类型存储在专用表中。标记为 externallyControlled，编辑和更新受限制。",
      "properties": [
        {
          "name": "setupAccess",
          "type": "Navigation",
          "description": "换线设置权限 → SetupAccess"
        },
        {
          "name": "changeHistory",
          "type": "Navigation",
          "description": "关联的变更历史记录（ChangeStatus）。"
        },
        {
          "name": "erpbomBase",
          "type": "Navigation",
          "description": "ERPBOM 基线引用 → ERPBOM"
        },
        {
          "name": "description",
          "type": "String",
          "description": "ERP BOM 的描述说明"
        },
        {
          "name": "iconId",
          "type": "Integer",
          "description": "关联图标的标识符。"
        },
        {
          "name": "isFrozen",
