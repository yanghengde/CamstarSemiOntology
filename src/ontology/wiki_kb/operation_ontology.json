{
  "module": "operation",
  "classes": [
    {
      "className": "ContainerLevel",
      "chineseName": "容器级别",
      "description": "ContainerLevel — 容器级别（命名对象）。定义在制品容器(Container)的追踪层级，如 Unit(单件)、Panel(拼板)、Batch(批次) 等。每个级别可配置容器编号规则(NumberingRule)、是否允许移动(AllowMove)、是否名称唯一(IsNameUnique)、级别类型(ES_LevelType)，以及 WIP 消息配置和 UI 偏好。Operation 通过 ThruputReportingLevelId 指定产出报告的容器级别。",
      "properties": [
        {
          "name": "setupAccess",
          "type": "Navigation",
          "description": "物理字段 SetupAccessId → A_SetupAccess"
        },
        {
          "name": "uiPreference",
          "type": "Navigation",
          "description": "UI显示配置偏好 → UIPreference"
        },
        {
          "name": "notes",
          "type": "String",
          "description": "备注说明"
        },
        {
          "name": "isFrozen",
          "type": "Boolean",
          "description": "是否已冻结（只读）"
        },
        {
          "name": "name",
