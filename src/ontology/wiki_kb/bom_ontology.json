  "classes": [
    {
      "className": "BOM",
      "chineseName": "物料清单",
      "description": "Bill of Materials — 定义制造一个产品所需的所有物料及其数量的主清单。BOM 包含多个 ProductMaterialListItem，每个 ProductMaterialListItem 指定一种物料及其需求数量。BOM 是连接 Product 和 Material 的核心枢纽：Product 通过 HAS_BOM 关联 BOM，MfgOrder 通过 BOM 的 RESOLVES_MATERIALS_FROM_BOM 解析运行时的物料需求。",
      "properties": [
        {
          "name": "bomBase",
          "type": "Navigation",
          "description": "BOM 基线引用 → BOM"
        },
        {
          "name": "setupAccess",
          "type": "Navigation",
          "description": "换线设置权限 → SetupAccess"
        },
        {
          "name": "changeHistory",
          "type": "Navigation",
          "description": "物理字段 ChangeHistoryId → ChangeStatus"
        },
        {
          "name": "iconId",
