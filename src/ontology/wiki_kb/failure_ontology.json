          "type": "String",
          "description": "备注说明"
        },
        {
          "name": "changeHistory",
          "type": "Navigation",
          "description": "变更历史记录"
        },
        {
          "name": "description",
          "type": "String",
          "description": "描述说明"
        },
        {
          "name": "iconId",
          "type": "Integer",
          "description": "关联的图标标识"
        },
        {
          "name": "isFrozen",
