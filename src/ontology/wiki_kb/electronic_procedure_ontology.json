{
  "module": "electronic_procedure",
  "classes": [
    {
      "className": "ElectronicProcedure",
      "chineseName": "电子程序",
      "description": "ElectronicProcedure — 电子程序（版本化实体）。分配给规范(Spec)执行的结构化操作引导程序。通过 EProcedureDetail 连接实体按顺序关联多个任务列表(TaskList)，每个任务列表包含多个任务(TaskItem)。任务类型包括 Instruction(操作指导)、MaterialIssue(物料发行)、DataCollection(数据采集)、Computation(计算)等。",
      "properties": [
        {
          "name": "electronicProcedureBase",
          "type": "Navigation",
          "description": "关联的电子程序基准版本 → ElectronicProcedureBase"
        },
        {
          "name": "setupAccess",
          "type": "Navigation",
          "description": "安全配置访问控制"
        },
        {
          "name": "notes",
          "type": "String",
          "description": "备注说明"
        },
        {
          "name": "changeHistory",
          "type": "Navigation",
          "description": "变更历史记录"
        },
        {
          "name": "description",
          "type": "String",
          "description": "描述说明"
        },
        {
          "name": "iconId",
          "type": "Integer",
          "description": "关联的图标标识"
        },
        {
          "name": "status",
          "type": "Integer",
          "description": "状态：1=Active, 2=Inactive"
        },
        {
          "name": "isFrozen",
          "type": "Boolean",
          "description": "是否已冻结（只读）"
        },
        {
          "name": "wipMsgDefMgr",
          "type": "Navigation",
          "description": "关联的WIP消息定义管理器"
        },
        {
          "name": "revision",
          "type": "String",
          "description": "修订版本号（必填）"
        },
        {
          "name": "eco",
          "type": "String",
          "description": "工程变更单号(ECO)"
        },
        {
          "name": "displayMode",
          "type": "Integer",
          "description": "显示模式：1=DrillDown(下钻), 2=Outline(大纲)"
        },
        {
          "name": "executionMode",
          "type": "Integer",
          "description": "执行模式：1=Sequential(顺序), 2=NonSequential(非顺序)（必填）"
        },
        {
          "name": "filterTags",
          "type": "String",
          "description": "分类筛选标签"
        }
      ]
    },
    {
      "className": "EProcedureDetail",
      "chineseName": "电子程序明细",
      "description": "EProcedureDetail — 电子程序明细（ElectronicProcedure 的子实体）。连接 ElectronicProcedure 与 TaskList，并定义该任务列表在电子程序中的执行顺序(sequence)。一个 TaskList 可被多个 EP 以不同顺序引用。",
      "properties": [
        {
          "name": "electronicProcedure",
          "type": "Navigation",
          "description": "关联的母电子程序流程 → ElectronicProcedure"
        },
        {
          "name": "isFrozen",
          "type": "Boolean",
          "description": "是否已冻结（只读）"
        },
        {
          "name": "sequence",
          "type": "Integer",
          "description": "任务列表在电子程序中的执行顺序号（必填）"
        },
        {
          "name": "taskListBase",
          "type": "Integer",
          "description": "关联的任务列表基准版本 → TaskListBase"
        },
        {
          "name": "taskList",
          "type": "Navigation",
          "description": "引用的任务列表(TaskList)（必填）"
        }
      ]
    },
    {
      "className": "TaskList",
      "chineseName": "任务列表",
      "description": "TaskList — 任务列表（版本化实体）。操作员在特定工序必须执行的任务集合，支持 Sequential(顺序执行) 和 AnyOrder(任意顺序) 两种执行模式。可指定前置任务列表(PrerequisiteTaskList)、工位(Workstation/WorkstationGroup)，以及通用指导说明(Instruction/ReportInstruction)。",
