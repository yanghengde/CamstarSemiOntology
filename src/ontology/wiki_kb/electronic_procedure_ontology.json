    {
      "className": "TaskItem",
      "chineseName": "任务项",
      "description": "TaskItem — 任务项（TaskList 的子实体）。操作员必须执行的单一动作。根据 taskType 决定关联的目标实体：Instruction(显示富文本指导)、MaterialIssue(物料发行)、DataCollection(数据采集)、Computation(公式计算)等。支持循环执行(minIterations/maxIterations)、自动推进(advanceToNextTask)、电子签名(eSigRequirement)、培训要求(trainingReqGroup)、前置任务(PrerequisiteTasks)等。",
      "properties": [
        {
          "name": "taskList",
          "type": "Navigation",
          "description": "关联的母任务列表 → TaskList"
        },
        {
          "name": "computation",
          "type": "Navigation",
          "description": "关联的计算公式(Computation)"
        },
        {
          "name": "isFrozen",
          "type": "Boolean",
          "description": "是否已冻结（只读）"
        },
        {
          "name": "name",
          "type": "String",
          "description": "任务项名称",
          "required": true
        },
        {
          "name": "taskType",
          "type": "Integer",
          "description": "任务类型编码：Instruction/MaterialIssue/DataCollection/Computation/Transaction/Checklist"
        },
        {
