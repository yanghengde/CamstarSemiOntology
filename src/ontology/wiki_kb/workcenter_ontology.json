{
  "module": "workcenter",
  "classes": [
    {
      "className": "WorkCenter",
      "chineseName": "工作中心",
      "description": "WorkCenter — 工作中心。车间中执行制造操作的物理或逻辑区域，是组织生产活动和追踪在制品(WIP)的基本单位。配置派工方法(dispatchMethod)、队列时间(fastQueueTime/normalQueueTime)、派工规则(DispatchRule)、制造日历(MfgCalendar)、资源组(ResourceGroup)、培训要求组(TrainingRequirementGroup)、WIP消息管理器(WIPMsgDefMgr)和工作时间表(WorkSchedule)。",
      "properties": [
        {
          "name": "setupAccess",
          "type": "Navigation",
          "description": "物理字段 SetupAccessId → A_SetupAccess"
        },
        {
          "name": "mfgCalendar",
          "type": "Navigation",
          "description": "制造日历 → MfgCalendar"
        },
        {
          "name": "resourceGroup",
          "type": "Navigation",
          "description": "默认资源组 → ResourceGroup"
        },
        {
          "name": "wipMsgDefMgr",
          "type": "Navigation",
          "description": "WIP消息定义管理器 → WIPMsgDefMgr"
        },
        {
          "name": "dispatchMethod",
          "type": "Integer",
          "description": "派工方法：1=Dispatch Queue Only(仅队列), 2=Dynamic Only(仅动态), 3=Both(队列+动态)"
        },
        {
          "name": "name",
          "type": "String",
          "description": "工作中心名称（必填）",
          "required": true
        },
        {
          "name": "description",
