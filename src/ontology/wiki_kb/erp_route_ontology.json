{
  "module": "erp_route",
  "classes": [
    {
      "className": "ERPRoute",
      "chineseName": "ERP工艺路线",
      "description": "ERPRoute — ERP工艺路线（版本化实体）。从ERP系统下载的制造工艺路线定义，是ERP中最接近Camstar工作流(Workflow)的概念。包含多个工艺步骤(RouteStep)，每个步骤比工作流工步更粗粒度（通常在步骤级汇总）。可选择关联特定的产品(Product)。被 Workflow、MfgOrder、ERPBOM 引用，将ERP的工艺路线与Camstar'的工单和工作流桥接。",
      "properties": [
        {
          "name": "erpRouteBase",
          "type": "Navigation",
          "description": "ERP工艺路线基线引用"
        },
        {
          "name": "setupAccess",
          "type": "Navigation",
          "description": "换线设置权限 → SetupAccess"
        },
        {
          "name": "revision",
          "type": "String",
          "description": "修订版本号"
        },
        {
          "name": "changeHistory",
          "type": "Navigation",
          "description": "变更历史记录"
        },
        {
          "name": "description",
          "type": "String",
          "description": "描述说明"
        },
        {
          "name": "isFrozen",
          "type": "Boolean",
          "description": "是否已冻结（只读）"
        },
        {
          "name": "erpItem",
          "type": "String",
          "description": "ERP系统对应的物料/项目编码"
        },
        {
          "name": "status",
          "type": "Integer",
          "description": "状态：1=Active, 2=Inactive"
        },
        {
          "name": "wipMsgDefMgr",
          "type": "Navigation",
          "description": "关联的WIP消息定义管理器"
        },
        {
          "name": "iconId",
          "type": "Integer",
          "description": "关联的图标标识"
        },
        {
          "name": "notes",
          "type": "String",
          "description": "备注说明"
        },
        {
          "name": "eco",
          "type": "String",
          "description": "工程变更单号(ECO)"
        },
        {
          "name": "filterTags",
          "type": "String",
          "description": "分类筛选标签"
        },
        {
          "name": "productBase",
          "type": "Integer",
