        },
        {
          "name": "product",
          "type": "Navigation",
          "description": "关联的产品(Product)，可选"
        }
      ]
    },
    {
      "className": "RouteStep",
      "chineseName": "ERP工艺步骤",
      "description": "RouteStep — ERP工艺步骤（ERPRoute 的子实体）。ERP工艺路线中的单个步骤，包含ERP工序代码(ERPOperation)、执行顺序(Sequence)、名称(Name)，以及SMT贴片相关参数（isSMTSide、isSMTDate、isTransferType 等）和产能计算参数（isSetupTime、isDurationPerUnit、isUnitsPerHour 等）。被 WorkflowStep 和物料清单行引用，用于将ERP步骤映射到具体工步和物料消耗位置。",
      "properties": [
        {
          "name": "name",
          "type": "String",
          "description": "步骤名称",
          "required": true
        },
        {
          "name": "isFrozen",
          "type": "Boolean",
          "description": "是否已冻结（只读）"
        },
        {
          "name": "erpRouteId",
          "type": "Navigation",
          "description": "物理字段 ERPRouteID → ERPRoute"
        },
        {
          "name": "description",
          "type": "String",
          "description": "描述说明"
        },
        {
          "name": "erpOperation",
          "type": "String",
          "description": "ERP工序操作代码"
        },
        {
          "name": "sequence",
          "type": "String",
          "description": "执行顺序号"
        },
        {
          "name": "schedulingOperation",
          "type": "String",
          "description": "排程操作代码(SchedulingOperation)"
        }
      ]
    }
  ],
